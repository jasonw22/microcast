# Copy to .env (git-ignored). Real coordinates never go in git.
MICROCAST_HOME_LAT=37.7609
MICROCAST_HOME_LON=-122.4350

# Own PurpleAir sensor index (from its widget embed code), optional LAN host
# for free local polling, and an API key for history / the public network.
MICROCAST_PURPLEAIR_SENSOR_INDEX=0
# MICROCAST_PURPLEAIR_HOST=192.168.1.50
# PURPLEAIR_API_KEY=

# Optional overrides
# MICROCAST_DATA_DIR=~/data/microcast
# MICROCAST_PLACES=config/places.local.yaml

# Historical collection bounds: lat_min,lat_max,lon_min,lon_max (SF defaults).
# Use a separate data directory/catalog when changing regions; completed batches
# are tracked by time. The terrain builder remains limited to the SF DEM.
# MICROCAST_HRRR_BOUNDS=37.55,37.95,-122.70,-122.15
# MICROCAST_MADIS_BOUNDS=37.60,37.90,-122.62,-122.33

# Point the catalog at Lakekeeper + MinIO/S3 later; when any of these are set
# they replace the local SQLite catalog. See docs/decisions.md D1.
# PYICEBERG_CATALOG__MICROCAST__TYPE=rest
# PYICEBERG_CATALOG__MICROCAST__URI=http://localhost:8181/catalog
# PYICEBERG_CATALOG__MICROCAST__WAREHOUSE=microcast
# PYICEBERG_CATALOG__MICROCAST__S3__ENDPOINT=http://localhost:9000
